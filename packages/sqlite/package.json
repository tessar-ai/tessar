{
  "name": "@tessar/sqlite",
  "version": "0.1.4",
  "license": "Apache-2.0",
  "description": "SQLite persistence for Tessar state and checkpoints using Node's built-in SQLite API.",
  "keywords": ["tessar","ai-agent","sqlite","storage","persistence","checkpoints","typescript"],
  "type": "module",
  "files": ["dist"],
  "engines": { "node": ">=24.22.1" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tessar-ai/tessar.git",
    "directory": "packages/sqlite"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@tessar/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json && node ../../scripts/copy-license.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}

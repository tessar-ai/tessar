{
  "name": "@tessar/client",
  "version": "0.1.0",
  "description": "Typed HTTP and SSE client for Tessar servers in browsers and Node.js.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/tessar-ai/tessar.git", "directory": "packages/client" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": ">=24.22.1" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json && node ../../scripts/copy-license.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}

{
  "name": "@tessar/logger",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Structured logging plugin with console and file transports for Tessar.",
  "keywords": ["tessar","ai-agent","typescript","plugin","logging"],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tessar-ai/tessar.git",
    "directory": "packages/logger"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"}
  },
  "files": ["dist"],
  "engines": {"node": ">=24.22.1"},
  "peerDependencies": {"@tessar/core": "workspace:^"},
  "peerDependenciesMeta": {"@tessar/core": {"optional": true}},
  "devDependencies": {"@tessar/core": "workspace:*"},
  "scripts": {"build": "tsc -p tsconfig.json", "prepack": "tsc -p tsconfig.json && node ../../scripts/copy-license.mjs", "typecheck": "tsc --noEmit -p tsconfig.json"}
}

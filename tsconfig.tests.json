{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@tessar/client": ["./packages/client/src/index.ts"],
      "@tessar/server": ["./packages/server/src/index.ts"],
      "@tessar/rag": ["./packages/rag/src/index.ts"],
      "@tessar/typesafe": ["./packages/typesafe/src/index.ts"],
      "@tessar/plugins/logger": [
        "./packages/plugins/src/build-in/logger.ts"
      ],
      "@tessar/opentelemetry": ["./packages/opentelemetry/src/index.ts"],
      "@tessar/plugins": [
        "./packages/plugins/src/index.ts"
      ],
      "@tessar/core": [
        "./packages/core/src/index.ts"
      ],
      "@tessar/core/tool": [
        "./packages/core/src/tools/index.ts"
      ],
      "@tessar/core/testing": [
        "./packages/core/src/testing/index.ts"
      ],
      "@tessar/libsql": [
        "./packages/libsql/src/index.ts"
      ],
      "@tessar/libsql/vector": ["./packages/libsql/src/vector.ts"],
      "@tessar/openai": [
        "./packages/openai/src/index.ts"
      ],
      "@tessar/core/testing/storage-conformance": [
        "./packages/core/src/testing/storage-conformance.ts"
      ],
      "@tessar/postgresql": [
        "./packages/postgresql/src/index.ts"
      ],
      "@tessar/postgresql/vector": ["./packages/postgresql/src/vector.ts"],
      "@tessar/mongodb": [
        "./packages/mongodb/src/index.ts"
      ],
      "@tessar/mongodb/vector": ["./packages/mongodb/src/vector.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "examples/**/*.ts",
    "vitest.config.ts"
  ]
}

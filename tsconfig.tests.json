{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@tessar/typesafe": ["./packages/typesafe/src/index.ts"],
      "@tessar/plugins/logger": [
        "./packages/plugins/src/build-in/logger.ts"
      ],
      "@tessar/opentelemetry": ["./packages/opentelemetry/src/index.ts"],
      "@tessar/plugins": [
        "./packages/plugins/src/index.ts"
      ],
      "@tessar/core": [
        "./packages/core/src/index.ts"
      ],
      "@tessar/core/tool": [
        "./packages/core/src/tools/index.ts"
      ],
      "@tessar/core/testing": [
        "./packages/core/src/testing/index.ts"
      ],
      "@tessar/sqlite": [
        "./packages/sqlite/src/index.ts"
      ],
      "@tessar/openai": [
        "./packages/openai/src/index.ts"
      ],
      "@tessar/core/testing/storage-conformance": [
        "./packages/core/src/testing/storage-conformance.ts"
      ],
      "@tessar/postgresql": [
        "./packages/postgresql/src/index.ts"
      ],
      "@tessar/mongodb": [
        "./packages/mongodb/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "examples/**/*.ts",
    "vitest.config.ts"
  ]
}

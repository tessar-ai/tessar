{
  "name": "@tessar/mongodb",
  "version": "0.1.5",
  "license": "Apache-2.0",
  "description": "MongoDB persistence for Tessar state, checkpoints and indexed vector storage.",
  "keywords": ["tessar","ai-agent","mongodb","storage","persistence","checkpoints","typescript"],
  "type": "module",
  "files": ["dist"],
  "engines": { "node": ">=24.22.1" },
  "repository": { "type": "git", "url": "git+https://github.com/tessar-ai/tessar.git", "directory": "plugins/database/mongodb" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./vector": { "types": "./dist/vector.d.ts", "import": "./dist/vector.js" }
  },
  "peerDependencies": { "@tessar/core": "workspace:^", "mongodb": "^6.21.0", "@tessar/rag": "workspace:^" },
  "peerDependenciesMeta": { "mongodb": { "optional": true }, "@tessar/rag": { "optional": true } },
  "devDependencies": { "@tessar/core": "workspace:*", "mongodb": "^6.21.0", "@tessar/rag": "workspace:*" },
  "scripts": { "build": "tsc -p tsconfig.json", "prepack": "tsc -p tsconfig.json && node ../../../scripts/copy-license.mjs", "typecheck": "tsc --noEmit -p tsconfig.json" }
}

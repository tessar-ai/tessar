# Copy the destinations you want into your existing .env and fill in their values.
# All three may be enabled together. Do not replace your OPENROUTER_* credentials.
# Blank/incomplete configurations are skipped and listed when the demo exits.

# Langfuse Cloud: project settings -> API keys; choose your project's region.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Arize AX Cloud: API key, space ID and application project name.
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=tessar-implement
# Optional full trace endpoint; the adapter otherwise uses Arize AX Cloud.
# ARIZE_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1/traces

# Traceloop Cloud: API key from the dashboard.
TRACELOOP_API_KEY=
# Optional base URL, without /v1/traces.
# TRACELOOP_BASE_URL=https://api.traceloop.com


